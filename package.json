{
  "name": "@langchain/langsmith-pi-extension",
  "version": "0.2.1",
  "description": "LangSmith tracing plugin for oh-my-pi (omp): traces prompts, agent steps, LLM calls, tools, subagents, steering, retries and compaction to LangSmith",
  "keywords": [
    "coding-agent",
    "langsmith",
    "observability",
    "oh-my-pi",
    "omp",
    "omp-extension",
    "omp-plugin",
    "tracing"
  ],
  "license": "MIT",
  "author": "LangChain",
  "repository": {
    "type": "git",
    "url": "https://github.com/langchain-ai/langsmith-pi-extension.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxfmt --check && tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "langsmith": "^0.10.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@oh-my-pi/pi-coding-agent": "^18.8.9",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.70.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.7.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "protobufjs": "7.6.5",
      "undici": "8.10.2",
      "ws": "8.21.0"
    }
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
